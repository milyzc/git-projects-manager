#!/usr/bin/env bash
# git-projects: track the git repositories of this machine from a YAML manifest and clone the missing ones.
# Manifest: --file <yml> | $GIT_PROJECTS_FILE | ~/.config/git-projects/projects.yml
#
# Usage:
#   git projects [list]  [--section <sec>] [--status <st>] [--identity] [--file <yml>]   table with repo state
#                        --identity: last column shows the user.name <user.email> each repo commits with,
#                        plus [signed] when commits are signed
#   git projects clone   [--section <sec>] [--status <st>] [--dry-run] [--adopt] [--protocol ssh|https] [--file <yml>]
#                        --adopt: a path that already has files but no .git gets `git init` + the manifest
#                        remotes, HEAD set to the remote branch and every local file kept for you to review
#   git projects paths   [--section <sec>] [--status <st>] [--file <yml>]   one existing repo path per line
#   git projects check   [--file <yml>]                                     validate the manifest
#   git projects init    [--file <yml>]                                     create the manifest from the template
#   git projects help    (or -h; `git projects --help` is taken by git and looks for a man page)
#   git projects version (or --version / -V)
#
# Status filter: active | paused | archived | all (clone defaults to everything except archived).
# Requires git and python3 (standard library only). Credentials never go in the manifest:
# https relies on the git credential helper, ssh on your keys/agent. Prompts are disabled.
set -euo pipefail

VERSION="0.1.1"

SELF="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd -P)"
DEFAULT_FILE="$HOME/.config/git-projects/projects.yml"
# identity includes for repos with submodules (see ensure_include)
IDENTITY_DIR="$HOME/.config/git-projects/identity"
INCLUDES_FILE="$HOME/.config/git-projects/includes.gitconfig"
MANIFEST="${GIT_PROJECTS_FILE:-$DEFAULT_FILE}"

cmd="list"
section=""
status_filter=""
dry_run=0
adopt=0
identity=0
protocol=""

die() { echo "git-projects: $1" >&2; exit "${2:-1}"; }

while [ $# -gt 0 ]; do
  case "$1" in
    list|clone|paths|check|init) cmd="$1"; shift ;;
    help)         sed -n '2,20p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -s|--section) [ -n "${2:-}" ] || die "--section needs a value" 2; section="$2"; shift 2 ;;
    --status)     [ -n "${2:-}" ] || die "--status needs a value" 2; status_filter="$2"; shift 2 ;;
    -f|--file)    [ -n "${2:-}" ] || die "--file needs a value" 2; MANIFEST="$2"; shift 2 ;;
    --protocol)   [ -n "${2:-}" ] || die "--protocol needs a value" 2; protocol="$2"; shift 2 ;;
    -n|--dry-run) dry_run=1; shift ;;
    --adopt)      adopt=1; shift ;;
    -i|--identity) identity=1; shift ;;
    version|-V|--version) echo "git-projects $VERSION"; exit 0 ;;
    -h|--help)    sed -n '2,20p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*)           die "unknown option: $1 (see: git projects help)" 2 ;;
    *)            die "unknown command: $1 (see: git projects help)" 2 ;;
  esac
done
MANIFEST="${MANIFEST/#\~/$HOME}"

case "$status_filter" in
  ""|all|active|paused|archived) ;;
  *) die "--status must be active, paused, archived or all" 2 ;;
esac
case "$protocol" in
  ""|ssh|https) ;;
  *) die "--protocol must be ssh or https" 2 ;;
esac

need_manifest() {
  [ -f "$MANIFEST" ] || die "manifest $MANIFEST not found (set GIT_PROJECTS_FILE, pass --file, or run: git projects init)"
}

# Parses the manifest and prints one row per project, fields separated by \x1f (a tab separator
# would make bash `read` collapse empty fields):
#   section  name  status  path  path_expanded  remotes  branch  submodules  gitcfg  notes
# `remotes` is "name=url name=url" with origin first. Exits 3 if a remote carries credentials.
# `gitcfg` is the local git config to write: "key=value" pairs separated by \x1e (user.name,
# user.email, user.signingkey, gpg.format, commit.gpgsign, tag.gpgsign). It comes from the
# project's `user:`, falling back key by key to the section's `defaults: user:`.
# In check mode it prints every problem found and exits 1 on errors.
parse_projects() {
  python3 - "$MANIFEST" "$section" "$status_filter" "${1:-rows}" <<'PY'
import os, re, sys

path, sec_filter, st_filter, mode = sys.argv[1:5]
STATUSES = ("active", "paused", "archived")
REMOTE_NAME = re.compile(r"^[A-Za-z0-9._-]+$")
URL_SCHEME = re.compile(r"^([A-Za-z][A-Za-z0-9+.-]*)://([^/]*)(/.*)?$")
SCP_LIKE = re.compile(r"^([^/@]+)@[^:/]+:")

def parse_simple_yaml(lines):
    """Nested mappings of scalars, indentation based. Enough for this manifest."""
    root = {}
    stack = [(-1, root)]
    for n, raw in enumerate(lines, 1):
        line = re.sub(r"(^|\s)#.*$", "", raw.replace("\t", "  ")).rstrip()
        if not line.strip():
            continue
        indent = len(line) - len(line.lstrip(" "))
        stripped = line.strip()
        if ":" not in stripped:
            raise ValueError(f"line {n}: expected 'key: value'")
        k, v = [x.strip() for x in stripped.split(":", 1)]
        if len(v) >= 2 and v[0] == v[-1] and v[0] in ("'", '"'):
            v = v[1:-1]
        while stack and indent <= stack[-1][0]:
            stack.pop()
        if not stack:
            raise ValueError(f"line {n}: bad indentation")
        parent = stack[-1][1]
        if v == "":
            child = {}
            parent[k] = child
            stack.append((indent, child))
        else:
            parent[k] = v
    return root

def load(text):
    try:
        import yaml  # type: ignore
        return yaml.safe_load(text) or {}
    except ImportError:
        return parse_simple_yaml(text.splitlines())

def cred_problem(url):
    m = URL_SCHEME.match(url)
    if m:
        scheme, auth, rest = m.group(1).lower(), m.group(2), m.group(3) or ""
        if "@" in auth:
            userinfo = auth.rsplit("@", 1)[0]
            if ":" in userinfo:
                return "user:password embedded in URL"
            if scheme in ("http", "https"):
                return "username embedded in https URL (let the credential helper supply it)"
        if re.search(r"[?&](access_|private_|oauth_)?token=|[?&]password=", rest, re.I):
            return "token in URL query"
        return None
    m = SCP_LIKE.match(url)
    if m and ":" in m.group(1):
        return "user:password embedded in URL"
    return None

def mask(url):
    url = re.sub(r"^([A-Za-z][A-Za-z0-9+.-]*://)[^/@]+@", r"\1***@", url)
    return re.sub(r"([?&](?:access_|private_|oauth_)?token=|[?&]password=)[^&]*", r"\1***", url, flags=re.I)

errors, warnings = [], []
def err(msg): errors.append(msg)
def warn(msg): warnings.append(msg)

USER_KEYS = ("name", "email", "signingkey", "sign", "format")
SIGN_FORMATS = ("ssh", "openpgp", "x509")
BOOLS = {"true": "true", "yes": "true", "1": "true", "false": "false", "no": "false", "0": "false"}

def parse_user(raw, label):
    """Returns the `user:` keys that are set (name, email, signingkey, sign, format), validated."""
    if raw is None or raw == "" or raw == {}:
        return {}
    if not isinstance(raw, dict):
        err(f"{label}: 'user' must be a mapping ({', '.join(USER_KEYS)})")
        return {}
    out = {}
    for key in USER_KEYS:
        val = raw.get(key, "")
        val = "" if val is None else str(val).strip()  # PyYAML gives a bool for `sign: true`
        if not val:
            continue
        if "\n" in val or "\x1f" in val or "\x1e" in val:
            err(f"{label}: user.{key} must be a single line")
            continue
        if key == "email" and ("@" not in val or any(ch.isspace() for ch in val)):
            err(f"{label}: user.email '{val}' is not an email address")
            continue
        if key == "sign":
            if val.lower() not in BOOLS:
                err(f"{label}: user.sign must be true or false")
                continue
            val = BOOLS[val.lower()]
        if key == "format":
            val = val.lower()
            if val not in SIGN_FORMATS:
                err(f"{label}: user.format must be one of {', '.join(SIGN_FORMATS)}")
                continue
        out[key] = val
    for key in raw:
        if str(key) not in USER_KEYS:
            warn(f"{label}: unknown key 'user.{key}' (expected {', '.join(USER_KEYS)})")
    return out

_gpg_cache = {}
def gpg_key_problem(key, fmt):
    """Returns why a gpg/gpgsm signing key is unusable on this machine, or None. Best effort:
    when the program is not installed it says so instead of failing."""
    import shutil, subprocess
    if (key, fmt) in _gpg_cache:
        return _gpg_cache[(key, fmt)]
    # same program git would run: gpg.<fmt>.program, then gpg.program (openpgp only), then the default
    prog = ""
    for cfg_key in ([f"gpg.{fmt}.program", "gpg.program"] if fmt == "openpgp" else [f"gpg.{fmt}.program"]):
        try:
            prog = subprocess.run(["git", "config", "--get", cfg_key], capture_output=True,
                                  text=True, timeout=10).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            prog = ""
        if prog:
            break
    prog = prog or ("gpg" if fmt == "openpgp" else "gpgsm")
    if not shutil.which(prog):
        result = f"{prog} not found, cannot sign with {fmt} on this machine"
    else:
        try:
            ok = subprocess.run([prog, "--batch", "--list-secret-keys", "--", key],
                                capture_output=True, timeout=10).returncode == 0
            result = None if ok else f"no secret key for it in {prog}"
        except (OSError, subprocess.SubprocessError) as exc:
            result = f"could not query {prog}: {exc}"
    _gpg_cache[(key, fmt)] = result
    return result

def git_config(user, label):
    """Turns a merged `user:` mapping into the local git config pairs to write."""
    pairs = [(f"user.{k}", user[k]) for k in ("name", "email") if k in user]
    key, sign, fmt = user.get("signingkey", ""), user.get("sign", ""), user.get("format", "")
    explicit_fmt = bool(fmt)
    if key or sign == "true":
        fmt = fmt or "ssh"
    if key and fmt == "ssh" and not key.startswith("key::"):
        key = os.path.expanduser(key)
        if not key.endswith(".pub"):
            # never point the config at a private key: only the public half belongs here
            hint = "" if explicit_fmt else " (for a GPG key ID add 'format: openpgp')"
            err(f"{label}: user.signingkey must be a public key file (.pub) or 'key::<public key>' for ssh{hint}")
            key = ""
        elif mode == "check" and not os.path.isfile(key):
            warn(f"{label}: user.signingkey {key} does not exist")
    elif key and mode == "check" and fmt in ("openpgp", "x509"):
        problem = gpg_key_problem(key, fmt)
        if problem:
            warn(f"{label}: user.signingkey {key}: {problem}")
    if key:
        pairs.append(("user.signingkey", key))
    elif sign == "true" and fmt == "ssh":
        warn(f"{label}: user.sign is true but there is no user.signingkey (ssh signing needs one)")
    if fmt:
        pairs.append(("gpg.format", fmt))
    if sign:
        pairs += [("commit.gpgsign", sign), ("tag.gpgsign", sign)]
    return "\x1e".join(f"{k}={v}" for k, v in pairs)

if not os.path.isfile(path):
    print(f"git-projects: manifest {path} not found", file=sys.stderr)
    sys.exit(1)
with open(path, encoding="utf-8") as fh:
    text = fh.read()
try:
    data = load(text)
except Exception as exc:  # noqa: BLE001
    print(f"git-projects: cannot parse {path}: {exc}", file=sys.stderr)
    sys.exit(1)
if not isinstance(data, dict):
    print(f"git-projects: {path}: top level must be a mapping of sections", file=sys.stderr)
    sys.exit(1)

rows = []
seen_paths = {}
for sec, projs in data.items():
    sec = str(sec)
    if projs is None:
        continue
    if not isinstance(projs, dict):
        err(f"section '{sec}' must be a mapping of projects")
        continue
    # `defaults` is reserved: values every project of the section inherits
    defaults = projs.get("defaults") or {}
    if not isinstance(defaults, dict):
        err(f"{sec}/defaults: must be a mapping of fields")
        defaults = {}
    for key in defaults:
        if str(key) != "user":
            warn(f"{sec}/defaults: unknown key '{key}' (only 'user' is inherited)")
    sec_user = parse_user(defaults.get("user"), f"{sec}/defaults")
    for name, cfg in projs.items():
        name = str(name)
        if name == "defaults":
            continue
        label = f"{sec}/{name}"
        if cfg is None:
            cfg = {}
        if not isinstance(cfg, dict):
            err(f"{label}: must be a mapping of fields")
            continue
        st = (str(cfg.get("status", "active") or "active")).strip().lower()
        if st not in STATUSES:
            err(f"{label}: unknown status '{st}' (expected one of {', '.join(STATUSES)})")
        p = str(cfg.get("path", "") or "").strip()
        p_exp = os.path.expanduser(p) if p else ""
        if not p:
            err(f"{label}: missing 'path'")
        elif p_exp in seen_paths:
            err(f"{label}: path {p} already used by {seen_paths[p_exp]}")
        else:
            seen_paths[p_exp] = label
        raw_remote = cfg.get("remote", None)
        remotes = []
        if raw_remote is None or raw_remote == "" or raw_remote == {}:
            warn(f"{label}: no 'remote' (will be listed but never cloned)")
        elif isinstance(raw_remote, str):
            remotes = [("origin", raw_remote.strip())]
        elif isinstance(raw_remote, dict):
            items = [(str(k), str(v or "").strip()) for k, v in raw_remote.items()]
            items.sort(key=lambda kv: 0 if kv[0] == "origin" else 1)
            remotes = items
        else:
            err(f"{label}: 'remote' must be a URL or a mapping name: url")
        clean = []
        for rname, url in remotes:
            if not REMOTE_NAME.match(rname):
                err(f"{label}: invalid remote name '{rname}'")
                continue
            if not url:
                err(f"{label}: remote '{rname}' has an empty URL")
                continue
            if any(ch.isspace() for ch in url):
                err(f"{label}: remote '{rname}' URL contains whitespace")
                continue
            problem = cred_problem(url)
            if problem:
                err(f"{label}: remote '{rname}' {problem}: {mask(url)}")
                if mode == "rows":
                    print(f"git-projects: {label}: remote '{rname}' {problem}: {mask(url)}", file=sys.stderr)
                    print("git-projects: refusing to continue; remove the credential from the manifest", file=sys.stderr)
                    sys.exit(3)
                continue
            clean.append(f"{rname}={url}")
        branch = str(cfg.get("branch", "") or "").strip()
        sub_raw = str(cfg.get("submodules", "false")).strip().lower()
        if sub_raw not in ("true", "false", "1", "0", "yes", "no"):
            err(f"{label}: 'submodules' must be true or false")
        submodules = "1" if sub_raw in ("true", "1", "yes") else "0"
        user = {**sec_user, **parse_user(cfg.get("user"), label)}
        gitcfg = git_config(user, label)
        notes = str(cfg.get("notes", "") or "").replace("\t", " ").replace("\n", " ").strip()
        rows.append((sec, name, st, p, p_exp, " ".join(clean), branch, submodules, gitcfg, notes))

if mode == "check":
    for m in errors:
        print(f"error: {m}")
    for m in warnings:
        print(f"warning: {m}")
    print(f"{len(rows)} project(s), {len(errors)} error(s), {len(warnings)} warning(s)")
    sys.exit(1 if errors else 0)

for row in rows:
    sec, st = row[0], row[2]
    if sec_filter and sec != sec_filter:
        continue
    if st_filter == "!archived" and st == "archived":
        continue
    if st_filter and st_filter not in ("all", "!archived") and st != st_filter:
        continue
    print("\x1f".join(row))
PY
}

# Rewrites a URL to the protocol asked with --protocol (GitHub/GitLab style paths only).
rewrite_url() {
  local url="$1" host path
  case "$protocol" in
    https)
      case "$url" in
        git@*:*)       host="${url#git@}"; path="${host#*:}"; host="${host%%:*}"; printf 'https://%s/%s\n' "$host" "$path" ;;
        ssh://git@*/*) host="${url#ssh://git@}"; path="${host#*/}"; host="${host%%/*}"; printf 'https://%s/%s\n' "$host" "$path" ;;
        *)             printf '%s\n' "$url" ;;
      esac ;;
    ssh)
      case "$url" in
        https://*/*/*) host="${url#https://}"; path="${host#*/}"; host="${host%%/*}"; printf 'git@%s:%s\n' "$host" "$path" ;;
        *)             printf '%s\n' "$url" ;;
      esac ;;
    *) printf '%s\n' "$url" ;;
  esac
}

repo_state() {
  local p_exp="$1"
  if [ -z "$p_exp" ]; then echo "no-path"
  elif [ ! -d "$p_exp" ]; then echo "missing"
  elif ! git -C "$p_exp" rev-parse --git-dir >/dev/null 2>&1; then echo "not-git"
  elif [ -n "$(git -C "$p_exp" status --porcelain 2>/dev/null)" ]; then echo "dirty"
  else echo "clean"
  fi
}

branch_info() {
  local p_exp="$1" br counts ahead behind
  br="$(git -C "$p_exp" symbolic-ref --short -q HEAD 2>/dev/null || echo "detached")"
  counts="$(git -C "$p_exp" rev-list --left-right --count '@{u}...HEAD' 2>/dev/null || true)"
  if [ -n "$counts" ]; then
    behind="${counts%%[[:space:]]*}"; ahead="${counts##*[[:space:]]}"
    [ "$ahead" != "0" ] && br="$br +$ahead"
    [ "$behind" != "0" ] && br="$br -$behind"
  fi
  printf '%s\n' "$br"
}

# Prints the "key=value" pairs of a gitcfg field (\x1e separated), one per line.
cfg_pairs() { [ -n "$1" ] && printf '%s\n' "$1" | tr '\036' '\n'; return 0; }

# Prints the manifest value of one git config key from a gitcfg field, or nothing.
# $1 gitcfg, $2 key (e.g. user.email)
cfg_get() {
  local kv
  while IFS= read -r kv; do
    [ "${kv%%=*}" = "$2" ] && { printf '%s\n' "${kv#*=}"; return 0; }
  done < <(cfg_pairs "$1")
  return 0
}

# Reads a git config key of a repo; booleans normalized so "yes" / "on" compare equal to "true".
# $1 repo dir, $2 key, $3 scope flag ("--local" or "")
git_cfg_read() {
  local type=""
  case "$2" in *.gpgsign) type="--type=bool" ;; esac
  git -C "$1" config ${3:+"$3"} $type --get "$2" 2>/dev/null || true
}

# Prints the identity a repo commits with as "name <email>", marking each part that is not in the
# repo's local config "(global)" and each part that differs from the manifest with "!". Appends
# "[signed]" when commit.gpgsign is on, or "[!signed]" / "[!unsigned]" when it differs from the manifest.
# $1 repo path, $2 gitcfg
identity_info() {
  local repo="$1" key want val out="" sign
  for key in name email; do
    want="$(cfg_get "$2" "user.$key")"
    val="$(git_cfg_read "$repo" "user.$key" --local)"
    if [ -z "$val" ]; then
      val="$(git_cfg_read "$repo" "user.$key")"
      [ -n "$val" ] && val="$val (global)" || val="(unset)"
    fi
    [ -n "$want" ] && [ "${val% (global)}" != "$want" ] && val="!$val"
    if [ "$key" = "name" ]; then out="$val"; else out="$out <$val>"; fi
  done
  want="$(cfg_get "$2" commit.gpgsign)"
  sign="$(git_cfg_read "$repo" commit.gpgsign)"
  if [ -n "$want" ] && [ "${sign:-false}" != "$want" ]; then
    [ "$want" = "true" ] && out="$out [!unsigned]" || out="$out [!signed]"
  elif [ "$sign" = "true" ]; then
    out="$out [signed]"
  fi
  printf '%s\n' "$out"
}

# Adds the declared remotes that an existing repo lacks; warns when a URL differs.
# $1 repo path, $2 "name=url name=url" (already protocol-rewritten)
ensure_remotes() {
  local repo="$1" remotes="$2" kv rname url current
  for kv in $remotes; do
    rname="${kv%%=*}"; url="${kv#*=}"
    if current="$(git -C "$repo" remote get-url "$rname" 2>/dev/null)"; then
      [ "$current" = "$url" ] || echo "  warning: remote '$rname' is $current, manifest says $url (left untouched)"
    elif [ "$dry_run" -eq 1 ]; then
      echo "  would run: git remote add $rname $url"
    else
      git -C "$repo" remote add "$rname" "$url" && echo "  added remote '$rname' -> $url"
    fi
  done
}

# Writes each manifest git config key (identity and signing) to a repo's local config when unset;
# warns when a different value is already there.
# $1 repo dir, $2 gitcfg, $3 label for messages ("" for the repo itself)
set_identity() {
  local dir="$1" where="${3:+ (submodule $3)}" kv key val current
  while IFS= read -r kv; do
    key="${kv%%=*}"; val="${kv#*=}"
    current="$(git_cfg_read "$dir" "$key" --local)"
    if [ -z "$current" ]; then
      if [ "$dry_run" -eq 1 ]; then
        echo "  would run: git config $key \"$val\"$where"
      else
        git -C "$dir" config --local "$key" "$val" && echo "  set $key = $val$where"
      fi
    elif [ "$current" != "$val" ]; then
      echo "  warning: $key is '$current'$where, manifest says '$val' (left untouched)"
    fi
  done < <(cfg_pairs "$2")
}

# Applies the manifest identity and signing config to a repo and to every initialized submodule
# (each submodule has its own config, so the superproject's settings do not reach commits made inside it).
# Repos with submodules also get a conditional include (see ensure_include), which covers submodules
# initialized later as well.
# $1 repo path, $2 gitcfg, $3 section, $4 project, $5 submodules flag ("1" or "0")
ensure_identity() {
  local repo="$1" sub
  [ -n "$2" ] || return 0
  set_identity "$repo" "$2" ""
  while IFS= read -r sub; do
    [ -n "$sub" ] && set_identity "$repo/$sub" "$2" "$sub"
  done < <(list_submodules "$repo")
  if [ "${5:-0}" = "1" ] || [ -f "$repo/.gitmodules" ]; then
    ensure_include "$repo" "$2" "$3" "$4"
  fi
}

# True when every initialized submodule would commit with the manifest values. $1 repo, $2 gitcfg
submodules_match() {
  local sub kv
  while IFS= read -r sub; do
    [ -n "$sub" ] || continue
    while IFS= read -r kv; do
      [ "$(git_cfg_read "$1/$sub" "${kv%%=*}")" = "${kv#*=}" ] || return 1
    done < <(cfg_pairs "$2")
  done < <(list_submodules "$1")
  return 0
}

# Initialized submodules of a repo (recursive), one display path per line.
# Reads the gitlinks from the index instead of `git submodule foreach`, which aborts at the first
# gitlink without a .gitmodules entry and would hide every submodule after it.
# $1 repo dir, $2 path prefix (internal, for recursion)
list_submodules() {
  local entry path
  while IFS= read -r -d '' entry; do
    [ "${entry%% *}" = "160000" ] || continue
    path="${entry#*$'\t'}"
    [ -e "$1/$path/.git" ] || continue
    echo "${2:-}$path"
    list_submodules "$1/$path" "${2:-}$path/"
  done < <(git -C "$1" ls-files -s -z 2>/dev/null)
}

# Gitlinks of a repo and its initialized submodules (recursive) with no entry in the .gitmodules
# of the repo that holds them, one path per line. `git submodule` commands fail where one exists.
# $1 repo dir, $2 path prefix (internal, for recursion)
unmapped_gitlinks() {
  local entry path mapped
  mapped="$(git -C "$1" config -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null | cut -d' ' -f2- || true)"
  while IFS= read -r -d '' entry; do
    [ "${entry%% *}" = "160000" ] || continue
    path="${entry#*$'\t'}"
    printf '%s\n' "$mapped" | grep -qxF -- "$path" || echo "${2:-}$path"
    if [ -e "$1/$path/.git" ]; then unmapped_gitlinks "$1/$path" "${2:-}$path/"; fi
  done < <(git -C "$1" ls-files -s -z 2>/dev/null)
}

# The git dir of every submodule lives under <repo>/.git/modules/, so a global
# `includeIf "gitdir:<repo>/"` reaches the repo, its submodules (current and future) and its
# worktrees. The identity goes to IDENTITY_DIR/<section>-<project>.gitconfig, the includeIf entries
# to INCLUDES_FILE (owned by this tool), and the global config only gets `include.path = INCLUDES_FILE`.
include_file_for() { printf '%s/%s.gitconfig\n' "$IDENTITY_DIR" "$(printf '%s-%s' "$1" "$2" | tr -c 'A-Za-z0-9._-' '_')"; }
include_key_for() { printf 'includeIf.gitdir:%s/.path\n' "$(cd "$1" && pwd -P)"; }

# $1 repo path, $2 gitcfg, $3 section, $4 project
ensure_include() {
  local repo="$1" gitcfg="$2" file key tmp kv
  file="$(include_file_for "$3" "$4")"
  key="$(include_key_for "$repo")"
  if [ "$dry_run" -eq 1 ]; then
    echo "  would write $file and include it for everything under $repo (submodules included)"
    return 0
  fi
  mkdir -p "$IDENTITY_DIR"
  tmp="$file.tmp.$$"
  rm -f "$tmp"
  while IFS= read -r kv; do
    git config -f "$tmp" "${kv%%=*}" "${kv#*=}"
  done < <(cfg_pairs "$gitcfg")
  if [ -f "$file" ] && cmp -s "$tmp" "$file"; then
    rm -f "$tmp"
  else
    mv "$tmp" "$file" && echo "  wrote $file"
  fi
  if [ "$(git config -f "$INCLUDES_FILE" --get "$key" 2>/dev/null || true)" != "$file" ]; then
    git config -f "$INCLUDES_FILE" "$key" "$file" && echo "  included it for everything under $repo (submodules included)"
  fi
  if ! git config --global --get-all include.path 2>/dev/null | grep -qxF "$INCLUDES_FILE"; then
    git config --global --add include.path "$INCLUDES_FILE" && echo "  added include.path = $INCLUDES_FILE to your global git config"
  fi
}

# One line for dry-run output: which git config keys clone would set. $1 gitcfg
cfg_keys() { cfg_pairs "$1" | sed 's/=.*//' | paste -sd ',' - | sed 's/,/, /g'; }

# Initializes the submodules of an existing repo when any is still uninitialized ("-" in status).
ensure_submodules() {
  local repo="$1"
  [ -f "$repo/.gitmodules" ] || { echo "  note: submodules: true but the repo has no .gitmodules"; return 0; }
  git -C "$repo" submodule status 2>/dev/null | grep -q '^-' || return 0
  if [ "$dry_run" -eq 1 ]; then
    echo "  would run: git submodule update --init --recursive"
    return 0
  fi
  if GIT_TERMINAL_PROMPT=0 git -C "$repo" submodule update --init --recursive --quiet; then
    echo "  initialized submodules"
  else
    echo "  failed: submodule update --init --recursive (check access to the submodule remotes)"
    return 1
  fi
}

# Turns a directory that already has files (but no .git) into a repo wired to the manifest remotes.
# Every local file is kept: HEAD and the index point at the remote branch, the working tree is
# untouched, so `git status` shows exactly how the local files differ from the remote.
# $1 repo path, $2 "name=url name=url" (origin first), $3 declared branch or ""
adopt_repo() {
  local repo="$1" remotes="$2" branch="$3" kv rname url first_name errlog
  first_name="${remotes%% *}"; first_name="${first_name%%=*}"
  if [ "$dry_run" -eq 1 ]; then
    echo "  would run: git init; git remote add <each remote>; git fetch $first_name; git reset --mixed $first_name/<branch> (files kept)"
    return 0
  fi
  git -C "$repo" init --quiet || return 1
  for kv in $remotes; do
    rname="${kv%%=*}"; url="${kv#*=}"
    git -C "$repo" remote add "$rname" "$url" || return 1
  done
  errlog="$(mktemp "${TMPDIR:-/tmp}/git-projects.XXXXXX")"
  if ! GIT_TERMINAL_PROMPT=0 git -C "$repo" fetch --quiet "$first_name" 2>"$errlog"; then
    echo "  failed (fetch): repo initialized with remotes, but could not reach $first_name"
    sed 's/^/    /' "$errlog"; rm -f "$errlog"
    return 1
  fi
  rm -f "$errlog"
  if [ -z "$branch" ]; then
    git -C "$repo" remote set-head "$first_name" -a >/dev/null 2>&1 || true
    branch="$(git -C "$repo" symbolic-ref -q "refs/remotes/$first_name/HEAD" 2>/dev/null || true)"
    branch="${branch#refs/remotes/$first_name/}"
  fi
  if [ -z "$branch" ] || ! git -C "$repo" rev-parse -q --verify "refs/remotes/$first_name/$branch" >/dev/null 2>&1; then
    [ -n "$branch" ] && git -C "$repo" symbolic-ref HEAD "refs/heads/$branch"
    echo "  adopted: $first_name has no commits${branch:+ on '$branch'}; files left unstaged. Commit and push when ready."
    return 0
  fi
  git -C "$repo" symbolic-ref HEAD "refs/heads/$branch"
  git -C "$repo" reset --quiet --mixed "$first_name/$branch" || return 1
  git -C "$repo" branch --quiet --set-upstream-to="$first_name/$branch" "$branch" >/dev/null 2>&1 || true
  echo "  adopted: HEAD at $first_name/$branch, local files kept. Run 'git status' there to compare."
}

rewrite_remotes() {
  local remotes="$1" kv out=""
  for kv in $remotes; do
    out="${out:+$out }${kv%%=*}=$(rewrite_url "${kv#*=}")"
  done
  printf '%s\n' "$out"
}

case "$cmd" in
  init)
    if [ -f "$MANIFEST" ]; then
      echo "manifest already exists: $MANIFEST"
      exit 0
    fi
    mkdir -p "$(dirname "$MANIFEST")"
    cp "$ROOT/templates/projects.yml" "$MANIFEST"
    echo "created $MANIFEST from template; edit it and run: git projects list"
    ;;

  list)
    need_manifest
    rows="$(parse_projects)"
    echo "manifest: $MANIFEST"
    last_col="PATH / NOTES"
    [ "$identity" -eq 1 ] && last_col="USER"
    # Column widths grow with the longest section/project name so long names stay aligned.
    w_sec=12 w_name=22
    while IFS=$'\x1f' read -r sec name _; do
      [ "${#sec}" -gt "$w_sec" ] && w_sec="${#sec}"
      [ "${#name}" -gt "$w_name" ] && w_name="${#name}"
    done <<< "$rows"
    printf '%-*s %-*s %-9s %-8s %-18s %s\n' "$w_sec" "SECTION" "$w_name" "PROJECT" "STATUS" "REPO" "BRANCH" "$last_col"
    printf '%-*s %-*s %-9s %-8s %-18s %s\n' "$w_sec" "-------" "$w_name" "-------" "------" "----" "------" "------------"
    found=0
    while IFS=$'\x1f' read -r sec name st p p_exp remotes branch submodules gitcfg notes; do
      [ -n "$name" ] || continue
      found=1
      state="$(repo_state "$p_exp")"
      br="-"
      case "$state" in clean|dirty) br="$(branch_info "$p_exp")" ;; esac
      [ -z "$remotes" ] && state="$state*"
      if [ "$identity" -eq 1 ]; then
        tail_info="-"
        case "$state" in clean*|dirty*)
          tail_info="$(identity_info "$p_exp" "$gitcfg")"
          [ -n "$gitcfg" ] && ! submodules_match "$p_exp" "$gitcfg" && tail_info="$tail_info !sub"
          ;;
        esac
      else
        tail_info="${p:-}"
        [ -n "$notes" ] && tail_info="${tail_info:+$tail_info — }$notes"
      fi
      printf '%-*s %-*s %-9s %-8s %-18s %s\n' "$w_sec" "$sec" "$w_name" "$name" "$st" "$state" "$br" "$tail_info"
    done <<< "$rows"
    [ "$found" -eq 1 ] || echo "(no projects matched)"
    echo "(* = no remote declared)"
    if [ "$identity" -eq 1 ]; then
      echo "(USER: (global) = not set in the repo, inherited from your git config; ! = differs from the manifest;"
      echo " [signed] = commit.gpgsign on; !sub = a submodule commits with something else, see: git projects check)"
    fi
    ;;

  paths)
    need_manifest
    rows="$(parse_projects)"
    while IFS=$'\x1f' read -r sec name st p p_exp remotes branch submodules gitcfg notes; do
      [ -n "$p_exp" ] && [ -d "$p_exp" ] && git -C "$p_exp" rev-parse --git-dir >/dev/null 2>&1 && printf '%s\n' "$p_exp"
      true  # a skipped last row must not become the exit status
    done <<< "$rows"
    ;;

  check)
    need_manifest
    echo "manifest: $MANIFEST"
    rc=0
    parse_projects check || rc=$?
    if [ "$rc" -eq 0 ]; then
      rows="$(parse_projects)"
      while IFS=$'\x1f' read -r sec name st p p_exp remotes branch submodules gitcfg notes; do
        [ -n "$name" ] || continue
        [ "$(repo_state "$p_exp")" = "clean" ] || [ "$(repo_state "$p_exp")" = "dirty" ] || continue
        for kv in $remotes; do
          rname="${kv%%=*}"; url="${kv#*=}"
          if current="$(git -C "$p_exp" remote get-url "$rname" 2>/dev/null)"; then
            [ "$current" = "$url" ] || echo "warning: $sec/$name: remote '$rname' is $current, manifest says $url"
          else
            echo "warning: $sec/$name: remote '$rname' not configured in $p (clone will add it)"
          fi
        done
        if [ -f "$p_exp/.gitmodules" ] && [ "$submodules" != "1" ]; then
          echo "warning: $sec/$name: repo has .gitmodules but manifest lacks 'submodules: true'"
        elif [ "$submodules" = "1" ] && git -C "$p_exp" submodule status 2>/dev/null | grep -q '^-'; then
          echo "warning: $sec/$name: submodules not initialized (clone will run submodule update --init)"
        fi
        while IFS= read -r sub; do
          echo "warning: $sec/$name: submodule $sub has no .gitmodules entry (git submodule commands fail; add it to .gitmodules or 'git rm --cached' it)"
        done < <(unmapped_gitlinks "$p_exp")
        while IFS= read -r kv; do
          key="${kv%%=*}"; want="${kv#*=}"
          current="$(git_cfg_read "$p_exp" "$key" --local)"
          if [ -z "$current" ]; then
            echo "warning: $sec/$name: $key not set in the repo (clone will set it)"
          elif [ "$current" != "$want" ]; then
            echo "warning: $sec/$name: $key is '$current', manifest says '$want'"
          fi
        done < <(cfg_pairs "$gitcfg")
        for key in user.name user.email; do
          if [ -z "$(cfg_get "$gitcfg" "$key")" ] && [ -z "$(git_cfg_read "$p_exp" "$key")" ]; then
            echo "warning: $sec/$name: no $key anywhere (add 'user:' to the project or the section's 'defaults:')"
          fi
        done
        if [ -n "$gitcfg" ] && { [ "$submodules" = "1" ] || [ -f "$p_exp/.gitmodules" ]; }; then
          inc_file="$(include_file_for "$sec" "$name")"
          if [ "$(git config -f "$INCLUDES_FILE" --get "$(include_key_for "$p_exp")" 2>/dev/null || true)" != "$inc_file" ] \
              || ! git config --global --get-all include.path 2>/dev/null | grep -qxF "$INCLUDES_FILE"; then
            echo "warning: $sec/$name: no identity include for its submodules (clone will add it)"
          fi
          # what a commit inside each submodule would actually use (local, include or global)
          while IFS= read -r sub; do
            [ -n "$sub" ] || continue
            while IFS= read -r kv; do
              key="${kv%%=*}"; want="${kv#*=}"
              current="$(git_cfg_read "$p_exp/$sub" "$key")"
              if [ -z "$current" ]; then
                echo "warning: $sec/$name: submodule $sub: $key not set (clone will set it)"
              elif [ "$current" != "$want" ]; then
                echo "warning: $sec/$name: submodule $sub: $key is '$current', manifest says '$want'"
              fi
            done < <(cfg_pairs "$gitcfg")
          done < <(list_submodules "$p_exp")
        fi
      done <<< "$rows"
      echo "ok"
    fi
    exit "$rc"
    ;;

  clone)
    need_manifest
    status_filter="${status_filter:-!archived}"
    rows="$(parse_projects)"
    echo "manifest: $MANIFEST"
    cloned=0; skipped=0; failed=0
    while IFS=$'\x1f' read -r sec name st p p_exp remotes branch submodules gitcfg notes; do
      [ -n "$name" ] || continue
      label="$sec/$name"
      if [ -z "$p_exp" ]; then
        echo "[$label] no path (skipped)"; skipped=$((skipped+1)); continue
      fi
      if [ -z "$remotes" ]; then
        echo "[$label] no remote (skipped)"; skipped=$((skipped+1)); continue
      fi
      remotes="$(rewrite_remotes "$remotes")"
      first="${remotes%% *}"
      origin_url="${first#*=}"
      if [ -d "$p_exp" ] && git -C "$p_exp" rev-parse --git-dir >/dev/null 2>&1; then
        echo "[$label] exists at $p (skipped)"
        ensure_remotes "$p_exp" "$remotes"
        if [ "$submodules" = "1" ]; then
          ensure_submodules "$p_exp" || failed=$((failed+1))
        fi
        ensure_identity "$p_exp" "$gitcfg" "$sec" "$name" "$submodules"
        skipped=$((skipped+1))
        continue
      fi
      if [ -d "$p_exp" ] && [ -n "$(ls -A "$p_exp" 2>/dev/null)" ]; then
        # directory with files that is not a repo: only --adopt touches it
        if [ "$adopt" -eq 1 ]; then
          echo "[$label] adopting $p -> $origin_url"
          if [ "$dry_run" -eq 1 ]; then
            adopt_repo "$p_exp" "$remotes" "$branch"
            [ -n "$gitcfg" ] && echo "  would set from the manifest: $(cfg_keys "$gitcfg")"
          elif adopt_repo "$p_exp" "$remotes" "$branch"; then
            ensure_identity "$p_exp" "$gitcfg" "$sec" "$name" "$submodules"
            cloned=$((cloned+1))
          else
            failed=$((failed+1))
          fi
        else
          echo "[$label] ERROR: $p exists with files but is not a git repository (use --adopt to init it with the manifest remotes)"
          failed=$((failed+1))
        fi
        continue
      fi
      # path missing or empty directory: git clone accepts both
      args=(clone --quiet)
      [ -n "$branch" ] && args+=(-b "$branch")
      [ "$submodules" = "1" ] && args+=(--recurse-submodules)
      args+=(-- "$origin_url" "$p_exp")
      # fallback for an empty remote: -b fails there because no branch exists yet
      args_nob=(clone --quiet -- "$origin_url" "$p_exp")
      if [ "$dry_run" -eq 1 ]; then
        echo "[$label] would run: git ${args[*]}"
        rest="${remotes#* }"
        [ "$rest" != "$remotes" ] && ensure_remotes "$p_exp" "$rest"
        if [ -n "$gitcfg" ]; then
          [ "$submodules" = "1" ] && sub_note=" (also in submodules)" || sub_note=""
          echo "  would set from the manifest$sub_note: $(cfg_keys "$gitcfg")"
        fi
        continue
      fi
      echo "[$label] cloning $origin_url -> $p"
      mkdir -p "$(dirname "$p_exp")"
      errlog="$(mktemp "${TMPDIR:-/tmp}/git-projects.XXXXXX")"
      if GIT_TERMINAL_PROMPT=0 git "${args[@]}" 2>"$errlog"; then
        ensure_remotes "$p_exp" "$remotes"
        ensure_identity "$p_exp" "$gitcfg" "$sec" "$name" "$submodules"
        cloned=$((cloned+1))
      elif [ -n "$branch" ] && grep -q 'not found in upstream' "$errlog" \
          && [ -z "$(GIT_TERMINAL_PROMPT=0 git ls-remote --heads -- "$origin_url" 2>/dev/null)" ] \
          && GIT_TERMINAL_PROMPT=0 git "${args_nob[@]}" 2>/dev/null; then
        git -C "$p_exp" symbolic-ref HEAD "refs/heads/$branch"
        ensure_remotes "$p_exp" "$remotes"
        ensure_identity "$p_exp" "$gitcfg" "$sec" "$name" "$submodules"
        echo "  cloned empty repository; HEAD set to '$branch'. Commit and push when ready."
        cloned=$((cloned+1))
      else
        if grep -qiE 'authentication failed|could not read username|permission denied|publickey|terminal prompts disabled|403' "$errlog"; then
          echo "  failed (auth): check your ssh key / credential helper for this host"
        else
          echo "  failed:"
        fi
        sed 's/^/    /' "$errlog"
        failed=$((failed+1))
      fi
      rm -f "$errlog"
    done <<< "$rows"
    echo "cloned: $cloned  skipped: $skipped  failed: $failed"
    [ "$failed" -eq 0 ] || exit 1
    ;;
esac
